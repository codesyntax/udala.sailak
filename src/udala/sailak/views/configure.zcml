<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="udala.sailak"
    >

  <!-- -*- extra stuff goes here -*- -->
  <include package="plone.app.contentmenu" />

  <browser:page
      name="departments_view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".departments_view.DepartmentsView"
      template="departments_view.pt"
      permission="zope2.View"
      layer="udala.sailak.interfaces.IBrowserLayer"
      menu="plone_displayviews"
      title="Departments view"
      />


  <browser:page
      name="view"
      for="udala.sailak.content.department.IDepartment"
      class=".department_view.DepartmentView"
      template="department_view.pt"
      permission="zope2.View"
      layer="udala.sailak.interfaces.IBrowserLayer"
      />

</configure>
